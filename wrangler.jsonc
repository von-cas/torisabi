{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "torisabi",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // No "triggers.crons" here on purpose: the worker @opennextjs/cloudflare
  // generates exports only `fetch`, with no `scheduled` handler, so a Cron
  // Trigger would fail at runtime instead of pinging anything. The Supabase
  // keep-alive is a daily Hermes cron that curls /api/health — see
  // MASTER-PLAN.md §7.
}
