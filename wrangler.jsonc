{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "torisabi",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Both hostnames point at the worker; src/middleware.ts 301-redirects the
  // apex to www so the site has one canonical host (MASTER-PLAN.md §10 SEO).
  "routes": [
    { "pattern": "www.torisabi.com", "custom_domain": true },
    { "pattern": "torisabi.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
  // No "triggers.crons" here on purpose: the worker @opennextjs/cloudflare
  // generates exports only `fetch`, with no `scheduled` handler, so a Cron
  // Trigger would fail at runtime instead of pinging anything. The Supabase
  // keep-alive is a daily Hermes cron that curls /api/health — see
  // MASTER-PLAN.md §7.
}
