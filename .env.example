# Copy to .env.local and fill in. Never commit real values.
# Supabase project: torisabi (Singapore region) — Settings → API

# Public: safe to expose in the browser, protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only: shared secret Hermes sends as `Authorization: Bearer <key>`.
HERMES_API_KEY=

# Public site config
NEXT_PUBLIC_SITE_URL=https://www.torisabi.com
NEXT_PUBLIC_FACEBOOK_ID=61563228086384
